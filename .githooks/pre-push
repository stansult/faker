#!/bin/sh
set -e

zero_oid="0000000000000000000000000000000000000000"
run_api=0
saw_ref=0

while read -r local_ref local_oid remote_ref remote_oid; do
  saw_ref=1
  if [ "$local_oid" = "$zero_oid" ] || [ "$remote_oid" = "$zero_oid" ]; then
    run_api=1
    continue
  fi

  if ! git diff --name-only --no-renames -z "$remote_oid" "$local_oid" |
    node scripts/change-scope.cjs
  then
    run_api=1
  fi
done

if [ "$saw_ref" -eq 0 ] || [ "$run_api" -eq 1 ]; then
  npm run test:api
else
  echo "Markdown-only push: skipping API tests."
fi
